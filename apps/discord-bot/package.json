{
  "name": "@bonafide/discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Bonafide Discord Bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "register": "tsx src/register-commands.ts"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^1.0.8",
    "discord.js": "^14.21.0",
    "dotenv": "^16.6.1",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.0.8",
    "youtube-dl-exec": "^3.1.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "youtube-dl-exec@3.1.12": true,
    "ffmpeg-static@5.3.0": true
  }
}
