generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuildConfig {
  guildId                     String   @id
  memberLogChannelId          String?
  dynamicVoiceCreateChannelId String?
  reactionRolesChannelId      String?
  enabledModules              String[] @default([])
  temporaryVoiceChannelIds    String[] @default([])
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  reactionRoleRules ReactionRoleRule[]

  @@map("guild_configs")
}

model ReactionRoleRule {
  guildId   String
  messageId String
  emojiKey  String
  roleId    String
  channelId String?
  mode      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@id([guildId, messageId, emojiKey])
  @@map("reaction_role_rules")
}

model DiscordSession {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      Json
  guilds    Json

  @@map("discord_sessions")
}

model OAuthState {
  state       String   @id
  callbackUrl String?
  createdAt   DateTime @default(now())

  @@map("oauth_states")
}