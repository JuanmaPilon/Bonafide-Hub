generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuildConfig {
  guildId                     String   @id
  memberLogChannelId          String?
  dynamicVoiceCreateChannelId String?
  defaultRoleId               String?
  xpSyncRequested             Boolean  @default(false)
  enabledModules              String[] @default([])
  temporaryVoiceChannelIds    String[] @default([])
  musicEnabled                Boolean  @default(true)
  musicRoleIds                String[] @default([])
  // Roles vetados: no ven los canales de voz dinámicos de Karpindomo.
  bannedVoiceRoleIds          String[] @default([])
  // "Loro de Karpindomo": mensajes aleatorios en un canal configurable.
  dailyMessagesChannelId       String?
  dailyMessagesEnabled         Boolean  @default(false)
  dailyMessagesMinMinutes      Int      @default(15)
  dailyMessagesMaxMinutes      Int      @default(90)
  logsChannelId                String?
  // Vigilado de Warcraft Logs: publica solo logs de RAID nuevos del gremio.
  logsWatchEnabled             Boolean  @default(false)
  // LEGACY: era el watch por personaje (endpoint /reports/character que no
  // existe en WCL v1). Se mantiene la columna para que prisma db push no
  // intente dropearla con datos; ya no se usa (ver logsWatchGuild).
  logsWatchCharacter           String?
  logsWatchGuild               String?
  logsWatchServer              String?
  logsWatchRegion              String?
  // LEGACY: antes permitía un destinatario individual; las sugerencias usan
  // únicamente suggestionsDmTiers. Se conserva para no borrar datos previos.
  suggestionsDmUserId          String?
  // Rangos (owner/admin/officer) que reciben las sugerencias.
  suggestionsDmTiers           String[] @default([])
  // Vigilado de Karuta: detecta grabs de cartas raras (print bajo, muy
  // wishlisteadas) en el canal donde postea Karuta y avisa en el mismo canal.
  karutaChannelId              String?
  karutaWatchEnabled           Boolean  @default(false)
  // ID del bot de Karuta (default: el oficial). Overrideable por si el
  // server usa un clon o Karuta cambia de aplicación.
  karutaBotUserId              String?
  karutaRarePrintMax           Int      @default(10)
  karutaRareWishlistMin        Int      @default(3)
  // Segundo umbral (más estricto): marca las cartas como "super raras" y la
  // Colección las pinta con un brillo tipo shiny.
  karutaSuperRarePrintMax      Int      @default(3)
  karutaSuperRareWishlistMin   Int      @default(10)
  // Tercer umbral (el tope): "ultra raras", con un brillo holográfico.
  karutaUltraRarePrintMax      Int      @default(1)
  karutaUltraRareWishlistMin   Int      @default(25)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  adminRoleModules  AdminRoleModule[]

  @@map("guild_configs")
}

// Permisos de staff: qué módulos del panel Admin ve cada rol de Discord.
// Solo el owner puede configurarlo. El owner siempre tiene acceso total.
model AdminRoleModule {
  id        String   @id @default(cuid())
  guildId   String
  roleId    String
  modules   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, roleId])
  @@map("admin_role_modules")
}

model Communication {
  id         String    @id @default(cuid())
  guildId    String
  title      String
  content    String
  authorName String?
  channelId  String?
  status     String    @default("draft")
  // Tag visible en la web: etiqueta corta (ej: "Raid") con color hex libre.
  tagLabel   String?
  tagColor   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  instances  CommunicationInstance[]

  @@index([guildId, status])
  @@map("communications")
}

// Cada vez que se publica una plantilla se crea una instancia: el
// "mensaje" concreto que quedó en Discord (con snapshot del contenido).
model CommunicationInstance {
  id                String   @id @default(cuid())
  communicationId   String
  guildId           String
  channelId         String
  discordMessageIds String[] @default([])
  title             String
  content           String
  authorName        String?
  // Snapshot del tag de la plantilla al publicar (visible en la web).
  tagLabel          String?
  tagColor          String?
  publishedAt       DateTime @default(now())
  communication     Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
  @@map("communication_instances")
}

// Frases del "Loro de Karpindomo": el bot publica una al azar a intervalos
// aleatorios en el canal configurado de la guild.
model DailyMessage {
  id        String   @id @default(cuid())
  guildId   String
  content   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@map("daily_messages")
}

// Log de raid sincronizado con Warcraft Logs. El API observa el report,
// guarda el resumen (para la web) y publica en Discord cuando tiene fights.
model RaidLog {
  id                 String    @id @default(cuid())
  guildId            String
  reportCode         String
  reportUrl          String
  title              String?
  zone               Int?
  fightCount         Int       @default(0)
  kills              Int       @default(0)
  summary            Json?
  status             String    @default("new") // new | live | synced | failed
  error              String?
  discordPosted      Boolean   @default(false)
  // Oculto (soft-delete): el usuario lo sacó de la lista. Se conserva la
  // fila para que el watcher NO lo vuelva a crear (reportCode presente).
  hidden             Boolean   @default(false)
  firstFightAt       DateTime?
  lastSyncedAt       DateTime?
  // Detectan si el report todavía está "en vivo" (WCL sigue agregando
  // fights). Si fightCount no creció desde la última sincronización, se
  // guarda cuándo se detectó por primera vez; una vez pasado el umbral sin
  // crecer, se considera terminado y recién ahí se publica.
  previousFightCount Int       @default(0)
  fightsStableSince  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([guildId])
  @@map("raid_logs")
}

// Evento del "Módulo X" (estilo Raid Helper): raids, M+, PvP o social.
// Configurable: título, descripción, fecha, imagen y tipo. Los signups
// se gestionan desde la web y, en una próxima iteración, desde Discord.
//
// Publicación en Discord: un evento puede crearse como Scheduled Event de
// Discord (en una sala de voz o externo) y/o publicar un aviso-embed en un
// canal de texto. Los ids se guardan acá para poder actualizar o limpiar.
model HubEvent {
  id                String   @id @default(cuid())
  guildId           String
  title             String
  description       String?
  type              String   @default("raid") // raid | mplus | pvp | social
  startsAt          DateTime
  // Duración del evento en minutos (opcional, para mostrar hora de fin).
  durationMinutes   Int?
  // Cierre de inscripciones: a partir de acá ya no se puede anotar.
  signupDeadline    DateTime?
  imageUrl          String?
  // Rol de Discord mínimo para entrar al roster principal: quien no lo tiene
  // y marca "Voy" se guarda como Bench (estilo Raid Helper).
  requiredRoleId    String?
  // Canal de texto donde se publica el aviso-embed (si aplica).
  publishChannelId  String?
  // Sala de voz donde se aloja el Scheduled Event (entity_type VOICE).
  voiceChannelId    String?
  // Id del Scheduled Event creado en Discord (si se creó).
  discordEventId    String?
  // Ids de los mensajes-aviso publicados en publishChannelId.
  discordMessageIds String[] @default([])
  // Recordatorios de asistencia: horas antes de startsAt en las que el bot
  // avisa a quienes tienen el rol requerido y todavía no se anotaron
  // (p. ej. [48, 24, 2]). Vacío = sin recordatorios.
  reminderHours       Int[]    @default([])
  // Cuáles de reminderHours ya se enviaron (evita re-envíos tras reinicios).
  reminderSentHours   Int[]    @default([])
  // Ids de los mensajes de recordatorio publicados en el canal (para poder
  // borrarlos cuando el evento se completa o se elimina).
  reminderMessageIds  String[] @default([])
  // Control de asistencia: cuándo se marcó el evento como completado y si ya
  // se mandó el informe al creador con los que no se anotaron.
  completedAt         DateTime?
  reportSentAt        DateTime?
  // Cuándo se re-renderizó el aviso de Discord por cierre de inscripciones
  // (embed rojo + botones deshabilitados). Evita re-publicarlo cada minuto.
  signupClosedAt      DateTime?
  // Pausa manual: frena recordatorios, recurrencia y anotaciones sin cancelar
  // el evento (se puede reactivar en cualquier momento).
  paused              Boolean  @default(false)
  // Recurrencia propia: cada X días se crea y publica una copia del evento.
  // El evento con recurrenceEnabled actúa como "cabecera" de la serie; las
  // copias generadas no repiten la recurrencia.
  recurrenceEnabled   Boolean  @default(false)
  recurrenceEveryDays Int?
  // Cuántos días ANTES de la fecha del evento se crea/publica la ocurrencia.
  recurrencePublishDaysBefore Int?
  // Próxima fecha en la que hay que generar la copia.
  recurrenceNextAt    DateTime?
  // Si está activo, al marcar el evento como Completado se borra de Discord
  // (evento agendado + aviso) una vez guardado el registro/informe.
  discordCleanupOnComplete Boolean @default(false)
  // Config guardada de la publicación (entityType voice|external, location,
  // recurrence none|daily|weekly|biweekly) para poder re-sincronizar.
  discordEventConfig Json?
  status            String   @default("scheduled") // scheduled | cancelled | completed
  createdByUserId   String?
  createdByUsername String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  signups           EventSignup[]

  @@index([guildId, startsAt])
  @@map("hub_events")
}

// Inscripción de un miembro a un evento: estado (sí/tentativo/no), rol de
// combate (tank/healer/melee/ranged), clase, spec, personaje y nota.
// La clase/spec se guardan como texto (snapshot) y los emojis se resuelven
// contra el catálogo RaidSpec de la guild al renderizar.
model EventSignup {
  id        String   @id @default(cuid())
  guildId   String
  eventId   String
  userId    String
  username  String
  status    String   @default("tentative") // yes | tentative | no
  role      String? // tank | healer | melee | ranged (legacy: dps)
  wowClass  String?
  spec      String?
  character String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event HubEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([guildId, eventId])
  @@map("event_signups")
}

// Catálogo de specs configurable por guild (estilo Raid Helper): cada fila
// es un (rol, clase, spec) con su emoji custom de Discord opcional. Lo
// administra el staff desde el panel Admin y alimenta el selector y el
// roster de inscripciones. Así sirve para cualquier juego sin tocar código.
model RaidSpec {
  id        String   @id @default(cuid())
  guildId   String
  role      String // tank | healer | melee | ranged
  className String
  specName  String
  emojiId   String?
  emojiName String?
  animated  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, role, className, specName])
  @@index([guildId, role])
  @@map("raid_specs")
}

// Biblioteca de imágenes del módulo de eventos. El staff sube banners y
// los reutiliza en los eventos. Se guardan como data URL (base64) para no
// depender de almacenamiento externo.
model EventImage {
  id        String   @id @default(cuid())
  guildId   String
  name      String?
  dataUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, createdAt])
  @@map("event_images")
}

// Registro de posesión de cartas raras de Karuta. Se alimenta con `kv`
// (ver una carta propia → "Owned by X") y se da de baja con `kb` (burn).
// Es best-effort: 1 carta = 1 dueño actual, con borrado manual como red.
model KarutaCard {
  id            String   @id @default(cuid())
  guildId       String
  code          String
  cardName      String?
  series        String?
  printNumber   Int?
  wishlistCount Int?
  edition       Int?
  imageUrl      String?
  ownerUserId   String?
  ownerUsername String?
  status        String   @default("owned") // owned | burned | traded_away
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([guildId, code])
  @@index([guildId, status])
  @@map("karuta_cards")
}

// Álbumes de Karuta (ka). Colección de un usuario: nombre del álbum, fondo
// y las imágenes de cada página. Se refresca cada vez que se ve una página.
model KarutaAlbum {
  id            String   @id @default(cuid())
  guildId       String
  ownerUserId   String?
  ownerUsername String?
  albumName     String?
  background    String?
  imageUrl      String?
  images        Json     @default("[]")
  page          Int?
  totalPages    Int?
  // "Puntero" al mensaje de Karuta que muestra el álbum: permite volver a
  // leerlo y obtener URLs de imagen vigentes (las del CDN vencen).
  channelId     String?
  messageId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pages KarutaAlbumPage[]

  @@index([guildId, updatedAt])
  @@map("karuta_albums")
}

// Imagen de una página del álbum guardada como bytes en NUESTRA base. Es la
// que evita depender de las URLs firmadas de Discord (vencen a las ~24 h):
// una vez cacheada, la Colección la muestra desde el API para siempre.
model KarutaAlbumPage {
  id        String   @id @default(cuid())
  albumId   String
  guildId   String
  page      Int
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  album KarutaAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, page])
  @@index([guildId])
  @@map("karuta_album_pages")
}

model DiscordSession {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      Json
  guilds    Json

  @@map("discord_sessions")
}

model OAuthState {
  state       String   @id
  callbackUrl String?
  createdAt   DateTime @default(now())

  @@map("oauth_states")
}

model XpConfig {
  guildId            String         @id
  messageXp          Int            @default(15)
  voiceXpPerMinute   Int            @default(3)
  cooldownSeconds    Int            @default(60)
  levelBaseXp        Int            @default(100)
  maxLevel           Int            @default(0)
  roleStacking       String         @default("stack")
  levelRoles         Json           @default("[]")
  roleMultipliers    Json           @default("[]")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("xp_configs")
}

model XpProfile {
  guildId      String
  userId       String
  xp           Int      @default(0)
  level        Int      @default(0)
  messageCount Int      @default(0)
  voiceMinutes Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([guildId, userId])
  @@map("xp_profiles")
}

model AuditLogEntry {
  id          String   @id @default(cuid())
  guildId     String
  actorUserId String?
  actorName   String?
  action      String
  targetType  String?
  targetId    String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([guildId, createdAt])
  @@map("audit_log_entries")
}