generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuildConfig {
  guildId                     String   @id
  memberLogChannelId          String?
  dynamicVoiceCreateChannelId String?
  reactionRolesChannelId      String?
  defaultRoleId               String?
  xpSyncRequested             Boolean  @default(false)
  enabledModules              String[] @default([])
  temporaryVoiceChannelIds    String[] @default([])
  musicEnabled                Boolean  @default(true)
  musicRoleIds                String[] @default([])
  // Roles vetados: no ven los canales de voz dinámicos de Karpindomo.
  bannedVoiceRoleIds          String[] @default([])
  // "Loro de Karpindomo": mensajes aleatorios en un canal configurable.
  dailyMessagesChannelId       String?
  dailyMessagesEnabled         Boolean  @default(false)
  dailyMessagesMinMinutes      Int      @default(15)
  dailyMessagesMaxMinutes      Int      @default(90)
  logsChannelId                String?
  // Vigilado de Warcraft Logs: publica solo logs de RAID nuevos del gremio.
  logsWatchEnabled             Boolean  @default(false)
  logsWatchGuild               String?
  logsWatchServer              String?
  logsWatchRegion              String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  reactionRoleRules ReactionRoleRule[]

  @@map("guild_configs")
}

model ReactionRoleRule {
  guildId   String
  messageId String
  emojiKey  String
  roleId    String
  channelId String?
  mode      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@id([guildId, messageId, emojiKey])
  @@map("reaction_role_rules")
}

model ReactionRolePanelJob {
  id          String   @id @default(cuid())
  guildId     String
  action      String
  channelId   String?
  messageId   String?
  title       String?
  description String?
  mode        String   @default("multiple")
  rules       Json     @default("[]")
  status      String   @default("pending")
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guildId, status])
  @@map("reaction_role_panel_jobs")
}

model Communication {
  id         String    @id @default(cuid())
  guildId    String
  title      String
  content    String
  authorName String?
  channelId  String?
  status     String    @default("draft")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  instances  CommunicationInstance[]

  @@index([guildId, status])
  @@map("communications")
}

// Cada vez que se publica una plantilla se crea una instancia: el
// "mensaje" concreto que quedó en Discord (con snapshot del contenido).
model CommunicationInstance {
  id                String   @id @default(cuid())
  communicationId   String
  guildId           String
  channelId         String
  discordMessageIds String[] @default([])
  title             String
  content           String
  authorName        String?
  publishedAt       DateTime @default(now())
  communication     Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
  @@map("communication_instances")
}

model ReactionRolePanel {
  guildId     String
  messageId   String
  channelId   String?
  title       String?
  description String?
  mode        String   @default("multiple")
  // "draft" = plantilla guardada sin publicar (messageId sintético);
  // "published" = tiene un mensaje real en Discord.
  status      String   @default("published")
  // Pares emoji/rol de la plantilla (fuente de verdad para el panel).
  rules       Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([guildId, messageId])
  @@map("reaction_role_panels")
}

// Frases del "Loro de Karpindomo": el bot publica una al azar a intervalos
// aleatorios en el canal configurado de la guild.
model DailyMessage {
  id        String   @id @default(cuid())
  guildId   String
  content   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@map("daily_messages")
}

// Log de raid sincronizado con Warcraft Logs. El API observa el report,
// guarda el resumen (para la web) y publica en Discord cuando tiene fights.
model RaidLog {
  id            String    @id @default(cuid())
  guildId       String
  reportCode    String
  reportUrl     String
  title         String?
  zone          Int?
  fightCount    Int       @default(0)
  kills         Int       @default(0)
  summary       Json?
  status        String    @default("new") // new | synced | failed
  error         String?
  discordPosted Boolean   @default(false)
  firstFightAt  DateTime?
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([guildId])
  @@map("raid_logs")
}

model DiscordSession {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      Json
  guilds    Json

  @@map("discord_sessions")
}

model OAuthState {
  state       String   @id
  callbackUrl String?
  createdAt   DateTime @default(now())

  @@map("oauth_states")
}

model XpConfig {
  guildId            String         @id
  messageXp          Int            @default(15)
  voiceXpPerMinute   Int            @default(3)
  cooldownSeconds    Int            @default(60)
  levelBaseXp        Int            @default(100)
  maxLevel           Int            @default(0)
  roleStacking       String         @default("stack")
  levelRoles         Json           @default("[]")
  roleMultipliers    Json           @default("[]")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("xp_configs")
}

model XpProfile {
  guildId      String
  userId       String
  xp           Int      @default(0)
  level        Int      @default(0)
  messageCount Int      @default(0)
  voiceMinutes Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([guildId, userId])
  @@map("xp_profiles")
}

model AuditLogEntry {
  id          String   @id @default(cuid())
  guildId     String
  actorUserId String?
  actorName   String?
  action      String
  targetType  String?
  targetId    String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([guildId, createdAt])
  @@map("audit_log_entries")
}