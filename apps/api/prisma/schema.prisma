generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuildConfig {
  guildId                     String   @id
  memberLogChannelId          String?
  dynamicVoiceCreateChannelId String?
  reactionRolesChannelId      String?
  defaultRoleId               String?
  xpSyncRequested             Boolean  @default(false)
  enabledModules              String[] @default([])
  temporaryVoiceChannelIds    String[] @default([])
  musicEnabled                Boolean  @default(true)
  musicRoleIds                String[] @default([])
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  reactionRoleRules ReactionRoleRule[]

  @@map("guild_configs")
}

model ReactionRoleRule {
  guildId   String
  messageId String
  emojiKey  String
  roleId    String
  channelId String?
  mode      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@id([guildId, messageId, emojiKey])
  @@map("reaction_role_rules")
}

model ReactionRolePanelJob {
  id          String   @id @default(cuid())
  guildId     String
  action      String
  channelId   String?
  messageId   String?
  title       String?
  description String?
  mode        String   @default("multiple")
  rules       Json     @default("[]")
  status      String   @default("pending")
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guildId, status])
  @@map("reaction_role_panel_jobs")
}

model ReactionRolePanel {
  guildId     String
  messageId   String
  channelId   String?
  title       String?
  description String?
  mode        String   @default("multiple")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([guildId, messageId])
  @@map("reaction_role_panels")
}

model DiscordSession {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      Json
  guilds    Json

  @@map("discord_sessions")
}

model OAuthState {
  state       String   @id
  callbackUrl String?
  createdAt   DateTime @default(now())

  @@map("oauth_states")
}

model XpConfig {
  guildId            String         @id
  messageXp          Int            @default(15)
  voiceXpPerMinute   Int            @default(3)
  cooldownSeconds    Int            @default(60)
  levelBaseXp        Int            @default(100)
  maxLevel           Int            @default(0)
  roleStacking       String         @default("stack")
  levelRoles         Json           @default("[]")
  roleMultipliers    Json           @default("[]")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("xp_configs")
}

model XpProfile {
  guildId      String
  userId       String
  xp           Int      @default(0)
  level        Int      @default(0)
  messageCount Int      @default(0)
  voiceMinutes Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([guildId, userId])
  @@map("xp_profiles")
}

model AuditLogEntry {
  id          String   @id @default(cuid())
  guildId     String
  actorUserId String?
  actorName   String?
  action      String
  targetType  String?
  targetId    String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([guildId, createdAt])
  @@map("audit_log_entries")
}