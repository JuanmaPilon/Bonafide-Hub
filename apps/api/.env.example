DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback
SESSION_SECRET=change-me-to-a-long-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bonafide_api?schema=public
# Token del bot de Discord para listar canales de voz en el panel Admin
DISCORD_BOT_TOKEN=
# API key gratuita de Warcraft Logs (warcraftlogs.com -> API) para el
# vigilado de perfil (publica logs de RAID nuevos automaticamente)
WARCRAFT_LOGS_API_KEY=
# Exclusividad: si se setea, el hub solo funciona para este servidor (ej: Bonafide)
BONAFIDE_GUILD_ID=
CORS_ORIGINS=http://localhost:5173
COOKIE_SAME_SITE=Lax
FRONTEND_APP_URL=http://localhost:5173
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
