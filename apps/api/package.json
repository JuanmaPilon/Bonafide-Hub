{
  "name": "@bonafide/api",
  "version": "0.1.0",
  "private": true,
  "description": "Bonafide API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
